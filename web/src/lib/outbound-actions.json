{
  "version": 1,
  "note": "Patterns that mark a permission request as an action that leaves the local machine. Each entry names the rule and the warning category. Patterns use ECMAScript regular expressions without flags. Entries are only ever added, never removed or narrowed. The classifier defaults every unrecognized shell command to the unknown warning bucket, so these rules only refine the category of a request that already fails closed.",
  "actions": [
    { "id": "git-push", "kind": "push", "pattern": "\\bgit(?:\\s+(?:-C\\s+\\S+|-c\\s+\\S+|--(?:git-dir|work-tree|namespace|super-prefix|config-env|attr-source)\\s+\\S+|-\\S+))*\\s+push\\b" },
    { "id": "git-send-email", "kind": "send", "pattern": "\\bgit\\s+send-email\\b" },
    { "id": "gh-pull-request-merge", "kind": "push", "pattern": "\\bgh\\s+pr\\s+merge\\b" },
    { "id": "glab-merge-request-merge", "kind": "push", "pattern": "\\bglab\\s+mr\\s+merge\\b" },
    { "id": "hosted-cli-write", "kind": "send", "pattern": "\\b(?:gh|glab|hub|tea)\\s+(?:pr|issue|repo|release|run|workflow|gist|secret|variable|label|project|cache|attestation|ssh-key|gpg-key|mr|pipeline|ci|snippet|schedule)\\b[^|;&\\n]*\\b(?:create|edit|close|reopen|delete|review|comment|ready|update-branch|upload|archive|unarchive|rename|transfer|sync|fork|set|add|remove|rerun|cancel|enable|disable|trust|pin|unpin|note|approve|revoke|subscribe|unsubscribe|todo|develop)\\b" },
    { "id": "mcp-branch-write", "kind": "push", "pattern": "mcp__[A-Za-z0-9_-]*[Gg]it[A-Za-z0-9_-]*__[A-Za-z0-9_-]*(?:push_files|create_or_update_file|delete_file|create_pull_request|merge_pull_request|create_issue|create_pr)\\b" },
    { "id": "docker-push", "kind": "deploy", "pattern": "\\b(?:docker|podman|nerdctl)(?:\\s+--?\\S+)*\\s+push\\b" },
    { "id": "docker-compose-push", "kind": "deploy", "pattern": "\\b(?:docker|podman|nerdctl)\\s+compose\\b[^\\n]*\\spush\\b" },
    { "id": "docker-buildx-push", "kind": "deploy", "pattern": "\\bdocker\\s+buildx\\s+build\\b[^\\n]*\\s--push(?=\\s|$)" },
    { "id": "package-publish", "kind": "deploy", "pattern": "\\b(?:npm|pnpm|yarn|bun|cargo|gem|twine|poetry|flit|lerna)\\s+(?:publish|upload)\\b" },
    { "id": "registry-publish", "kind": "deploy", "pattern": "\\b(?:nuget|dotnet\\s+nuget|choco|helm|mvn|gradle)\\b[^|;&\\n]*\\b(?:push|deploy|publish|uploadArchives)\\b" },
    { "id": "kubectl-change", "kind": "deploy", "pattern": "\\bkubectl\\s+(?!config\\b)(?:\\S+\\s+)*(?:apply|create|delete|patch|replace|rollout|scale|set|edit)\\b" },
    { "id": "helm-change", "kind": "deploy", "pattern": "\\bhelm\\s+(?:install|upgrade|uninstall|rollback|delete)\\b" },
    { "id": "terraform-change", "kind": "deploy", "pattern": "\\b(?:terraform|tofu|pulumi)\\s+(?:apply|destroy|import|up)\\b" },
    { "id": "cloud-deploy", "kind": "deploy", "pattern": "\\b(?:gcloud|firebase|netlify|doctl|render|railway|surge|az|aws)\\b[^|;&\\n]*\\b(?:deploy|up|publish)\\b" },
    { "id": "wrangler-deploy", "kind": "deploy", "pattern": "\\bwrangler\\s+(?:deploy|publish)\\b" },
    { "id": "fly-deploy", "kind": "deploy", "pattern": "\\b(?:fly|flyctl)\\s+deploy\\b" },
    { "id": "vercel-production", "kind": "deploy", "pattern": "\\bvercel\\b[^\\n]*\\s--prod\\b" },
    { "id": "mcp-message-send", "kind": "send", "pattern": "mcp__[A-Za-z0-9_-]*(?:[Ss]lack|[Dd]iscord|[Tt]elegram|[Tt]eams|[Ww]hats[Aa]pp|[Ww]e|[Cc]hat|[Mm]ail|[Gg]mail)[A-Za-z0-9_-]*__[A-Za-z0-9_-]*(?:send|post|reply|message|webhook|email)[A-Za-z0-9_]*" },
    { "id": "mcp-generic-send", "kind": "send", "pattern": "mcp__[A-Za-z0-9_-]*__[A-Za-z0-9_-]*(?:send_message|post_message|send_email|send_mail|create_message|add_comment|post_comment)\\b" },
    { "id": "mail-send", "kind": "send", "pattern": "\\b(?:sendmail|mailx|mutt|mail|msmtp|esmtp|ssmtp|swaks|mailsend)\\s" },
    { "id": "curl-write", "kind": "send", "pattern": "\\bcurl\\b[^|;&\\n]*(?:(?:-X|--request|--method)(?:=|\\s+)?(?:POST|PUT|PATCH|DELETE|post|put|patch|delete)\\b|(?:^|\\s)-[A-Za-z]*[dFT](?=\\s|$|@|=|[A-Za-z])|--data(?:-raw|-binary|-urlencode)?(?:=|\\s)|--form(?:-string)?(?:=|\\s)|--upload-file(?:=|\\s)|--json(?:=|\\s))" },
    { "id": "wget-write", "kind": "send", "pattern": "\\bwget\\b[^|;&\\n]*(?:--post-data|--post-file|--body-data|--body-file|--method(?:=|\\s+)(?:POST|PUT|PATCH|DELETE))" },
    { "id": "hosted-cli-api-write", "kind": "send", "pattern": "\\b(?:gh|glab|hub|tea)\\s+api\\b[^|;&\\n]*(?:(?:-X|--method)(?:=|\\s+)?(?:POST|PUT|PATCH|DELETE|post|put|patch|delete)\\b|-f\\b|-F\\b|--raw-field(?:=|\\s)|--field(?:=|\\s)|--input(?:=|\\s))" },
    { "id": "httpie-write", "kind": "send", "pattern": "\\b(?:http|httpie|xh)\\s+(?:POST|PUT|PATCH|DELETE|post|put|patch|delete)\\b|\\b(?:http|httpie|xh)\\s+--method(?:=|\\s+)" },
    { "id": "webhook-post", "kind": "send", "pattern": "\\b(?:curl|wget)\\b[^\\n]*(?:webhook|hooks\\.[a-z0-9-]+\\.(?:com|net|org|io|app|dev))" },
    { "id": "gem-push", "kind": "deploy", "pattern": "\\bgem\\s+push\\b" },
    { "id": "aws-write", "kind": "deploy", "pattern": "\\baws\\b[^|;&\\n]*\\s(?:s3\\s+(?:cp|sync|mv|rm|mb|rb|presign)|(?:[a-z0-9-]+\\s+)*(?:create|update|put|delete|modify|patch|invoke|deploy|run|send|copy|sync|revoke|authorize|attach|detach|start|stop|terminate|reboot|apply)\\b)" },
    { "id": "other-vcs-push", "kind": "push", "pattern": "\\b(?:hg|bzr)\\s+push\\b|\\bsvn\\s+(?:commit|import)\\b" },
    { "id": "chat-cli-send", "kind": "send", "pattern": "\\b(?:signal-cli|telegram-send|slack-cli|mattermost|twilio)\\b[^|;&\\n]*\\b(?:send|post|message)\\b" }
  ]
}
